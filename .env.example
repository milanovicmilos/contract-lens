# Environment configuration template
# Copy to .env and fill in actual values

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000

# ChromaDB
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_COLLECTION_NAME=legal_regulations
# Optional: override the embedding model used by ChromaDB. Default is
# sentence-transformers/all-MiniLM-L6-v2 (90 MB, fast). For legal text
# recall, BAAI/bge-base-en-v1.5 (440 MB) materially improves retrieval.
EMBEDDING_MODEL=

# Kaggle (for training)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_KEY=your_kaggle_api_key

# Local Models
LOCAL_MODEL_NAME=microsoft/deberta-v3-large
LOCAL_MODEL_CACHE_DIR=./models/cache
QUANTIZE_MODEL=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/contractlens.log

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# API security (REQUIRED in production)
# Comma-separated list of accepted X-API-Key values. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CONTRACTLENS_API_KEYS=replace_me_with_a_real_key,optionally_a_second_key
# Set to 1 ONLY for local dev / CI. The server logs a loud WARNING when on.
API_AUTH_DISABLED=
# Per-endpoint rate limits (slowapi syntax: "<count>/<minute|second|hour>").
RATE_LIMIT_DEFAULTS=120/minute
RATE_LIMIT_ANALYZE=60/minute
RATE_LIMIT_REPORT=10/minute
RATE_LIMIT_UPLOAD=10/minute
# Max request body size in MB (rejects 413). Defaults to 5 if unset.
MAX_REQUEST_BODY_MB=5
# CORS allowlist — comma-separated origins. Empty = no CORS (most restrictive).
ALLOWED_ORIGINS=

# Async upload / background jobs (POST /api/v1/contracts)
# Worker count for the per-process job ThreadPoolExecutor (default 2).
JOB_WORKERS=2
# SQLite path for job state. Auto-created. Defaults to data/jobs.sqlite.
JOBS_DB_PATH=data/jobs.sqlite

# Data paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
MODELS_DIR=./models
